{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true, // Keep true during migration to allow .js and .ts to coexist
    "checkJs": false,
    "skipLibCheck": true,
    "strict": true, // Keep the Incoming strictness for better code quality
    "noEmit": true,
    "noImplicitAny": false, // Keep false from Incoming to avoid thousands of errors at once
    "useUnknownInCatchVariables": false,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"],
      "@/ui/*": ["./components/ui/*"],
      "configs/*": ["./configs/*"],
      "app/*": ["./app/*"]
    }
  },
  "include": [
    "next-env.d.ts", 
    ".next/types/**/*.ts", 
    "**/*.ts", 
    "**/*.tsx",
    "**/*.js", // Include these so the project still sees your old files
    "**/*.jsx"
  ],
  "exclude": ["node_modules"]
}